# Optional: enable GA4 page views and events without changing the UI.
VITE_GA_MEASUREMENT_ID=

# Admin backend. Set these in Netlify → Site configuration → Environment variables.
# Do not prefix secrets with VITE_; VITE_ variables are exposed to the browser.
# LUNAR_ADMIN_SESSION_SECRET must be a distinct random string of at least 32 characters.
# Generate one locally with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Set these only in Netlify's environment variables. Never commit real credentials.
LUNAR_ADMIN_ACCOUNT=Lunar Talisman
LUNAR_ADMIN_PASSWORD=
LUNAR_ADMIN_SESSION_SECRET=

# Live site URL. Used in secure payment return links and transactional emails.
SITE_URL=https://lunartalisman.com

# PayPal Orders API. These server-only variables never use a VITE_ prefix.
# Start with sandbox. Switch PAYPAL_ENVIRONMENT to live only after test payments pass.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Register this deployed endpoint in PayPal after the code is online:
# https://lunartalisman.com/.netlify/functions/paypal-webhook
PAYPAL_WEBHOOK_ID=

# Transactional email via Resend. Leave empty to keep email delivery disabled
# while the website, order, and payment flows remain functional.
RESEND_API_KEY=
ORDER_EMAIL_FROM="Lunar Talisman <orders@lunartalisman.com>"
ORDER_NOTIFICATION_EMAIL=
BRAND_SUPPORT_EMAIL=hello@lunartalisman.com

# Public-only environment variables.
VITE_GA_MEASUREMENT_ID=
